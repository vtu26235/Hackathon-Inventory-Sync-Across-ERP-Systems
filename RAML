
#%RAML 1.0
title: Retail Inventory Sync API
description: >
  Inventory event validation and synchronization API.
  Structural validation is performed by APIKit. Database, business,
  duplicate, stale-event, concurrency, and messaging checks are
  performed by Mule flows.
version: v1
baseUri: /api
mediaType: application/json
protocols:
  - HTTP

types:
  MovementType:
    type: string
    enum:
      - GOODS_RECEIPT
      - SALE
      - RETURN
      - TRANSFER
      - ADJUSTMENT

  EventStatus:
    type: string
    enum:
      - ACCEPTED
      - REJECTED
      - STALE
      - DUPLICATE
      - CONFLICT
      - RETRY_PENDING
      - FAILED

  Reason:
    type: object
    additionalProperties: false
    properties:
      code:
        type: string
        minLength: 1
        example: SKU_NOT_FOUND
      field:
        type: string
        required: false
        example: sku
      message:
        type: string
        minLength: 1
        example: The supplied SKU does not exist in the product master.
      category:
        type: string
        enum:
          - INPUT
          - BUSINESS
          - MASTER_DATA
          - ORDERING
          - DUPLICATE
          - CONCURRENCY
          - TECHNICAL
          - AUTHORIZATION
      retryable:
        type: boolean
        default: false

  InventoryEvent:
    type: object
    additionalProperties: false
    properties:
      eventId:
        type: string
        minLength: 1
        maxLength: 100
        example: INV-EVT-77120
      eventVersion:
        type: integer
        minimum: 1
        example: 14
      eventTimestamp:
        type: datetime
        format: rfc3339
        example: 2026-09-11T12:40:15+05:30
      sku:
        type: string
        minLength: 1
        maxLength: 100
        example: SKU-TSHIRT-BLK-M
      locationCode:
        type: string
        minLength: 1
        maxLength: 100
        example: WH-CHN-01
      movementType:
        type: MovementType
      quantityOnHand:
        type: integer
        minimum: 0
        example: 480
      reservedQuantity:
        type: integer
        minimum: 0
        example: 35
      unitOfMeasure:
        type: string
        minLength: 1
        maxLength: 20
        example: EA
      referenceDocument:
        type: string
        minLength: 1
        maxLength: 150
        required: false
        example: GRN-2026-55210

  InventoryBatchRequest:
    type: object
    additionalProperties: false
    properties:
      sourceSystem:
        type: string
        minLength: 1
        maxLength: 100
        example: ERP-SAP-PRD
      batchId:
        type: string
        minLength: 1
        maxLength: 100
        example: INV-BATCH-2026-09-11-0034
      events:
        type: InventoryEvent[]
        minItems: 1

  ValidationCheck:
    type: object
    additionalProperties: false
    properties:
      code:
        type: string
        example: QUANTITY_RULES
      valid:
        type: boolean
      message:
        type: string
        example: Reserved quantity does not exceed on-hand quantity.

  EventResult:
    type: object
    additionalProperties: false
    properties:
      eventId:
        type: string
        required: false
      sku:
        type: string
        required: false
      locationCode:
        type: string
        required: false
      valid:
        type: boolean
        description: >
          True means the event passed the applicable checks.
          False means a validation or processing failure occurred.
      validationStatus:
        type: string
        enum:
          - VALID
          - INVALID
      status:
        type: EventStatus
      reasonCode:
        type: string
        required: false
        example: STALE_EVENT_VERSION
      message:
        type: string
        example: Event rejected because its version is older than stored stock.
      validationReasons:
        type: Reason[]
      checks:
        type: ValidationCheck[]
        required: false
      availableQuantity:
        type: integer
        minimum: 0
        required: false
        example: 445
      stockUpdated:
        type: boolean
        default: false
      fanoutEligible:
        type: boolean
        default: false
      retryable:
        type: boolean
        default: false

  InventoryBatchResponse:
    type: object
    additionalProperties: false
    properties:
      valid:
        type: boolean
        description: True only when every event has validationStatus VALID.
      validationStatus:
        type: string
        enum:
          - VALID
          - INVALID
          - PARTIAL
      status:
        type: string
        enum:
          - SUCCESS
          - PARTIAL_SUCCESS
          - INVALID
          - FAILED
      message:
        type: string
      correlationId:
        type: string
      sourceSystem:
        type: string
        required: false
      batchId:
        type: string
        required: false
      processedCount:
        type: integer
        minimum: 0
      acceptedCount:
        type: integer
        minimum: 0
      rejectedCount:
        type: integer
        minimum: 0
      staleCount:
        type: integer
        minimum: 0
      duplicateCount:
        type: integer
        minimum: 0
      conflictCount:
        type: integer
        minimum: 0
      retryPendingCount:
        type: integer
        minimum: 0
      failedCount:
        type: integer
        minimum: 0
      results:
        type: EventResult[]

  ApiError:
    type: object
    additionalProperties: false
    properties:
      valid:
        type: boolean
        enum: [false]
      validationStatus:
        type: string
        enum: [INVALID]
      status:
        type: string
        example: INVALID_REQUEST
      errorCode:
        type: string
        example: APIKIT_BAD_REQUEST
      message:
        type: string
        example: Request validation failed.
      correlationId:
        type: string
        required: false
      validationReasons:
        type: Reason[]

/inventory/events:
  post:
    displayName: Validate and process inventory events
    description: >
      Accepts one batch containing one or more inventory events.
      Each event is checked independently so valid events can succeed
      when other events in the batch are rejected.
    body:
      application/json:
        type: InventoryBatchRequest
        example: |
          {
            "sourceSystem": "ERP-SAP-PRD",
            "batchId": "INV-BATCH-2026-09-11-0034",
            "events": [
              {
                "eventId": "INV-EVT-77120",
                "eventVersion": 14,
                "eventTimestamp": "2026-09-11T12:40:15+05:30",
                "sku": "SKU-TSHIRT-BLK-M",
                "locationCode": "WH-CHN-01",
                "movementType": "GOODS_RECEIPT",
                "quantityOnHand": 480,
                "reservedQuantity": 35,
                "unitOfMeasure": "EA",
                "referenceDocument": "GRN-2026-55210"
              },
              {
                "eventId": "INV-EVT-77121",
                "eventVersion": 9,
                "eventTimestamp": "2026-09-11T12:40:18+05:30",
                "sku": "SKU-SHOE-BRN-42",
                "locationCode": "STR-CHN-07",
                "movementType": "SALE",
                "quantityOnHand": 12,
                "reservedQuantity": 2,
                "unitOfMeasure": "EA",
                "referenceDocument": "POS-2026-881043"
              }
            ]
          }
    responses:
      200:
        description: All events were processed without business rejection.
        body:
          application/json:
            type: InventoryBatchResponse
      207:
        description: >
          Batch processing completed with mixed outcomes, such as accepted,
          stale, duplicate, rejected, or conflicting events.
        body:
          application/json:
            type: InventoryBatchResponse
      400:
        description: Malformed JSON or structural/input validation failure.
        body:
          application/json:
            type: ApiError
      401:
        description: Authentication is required or failed.
        body:
          application/json:
            type: ApiError
      403:
        description: Source system is not authorized.
        body:
          application/json:
            type: ApiError
      404:
        description: Endpoint or required resource was not found.
        body:
          application/json:
            type: ApiError
      405:
        description: HTTP method is not supported for this endpoint.
        body:
          application/json:
            type: ApiError
      415:
        description: Content type is not supported.
        body:
          application/json:
            type: ApiError
      500:
        description: Unexpected application or processing failure.
        body:
          application/json:
            type: ApiError
      503:
        description: A required dependency is temporarily unavailable.
        body:
          application/json:
            type: ApiError

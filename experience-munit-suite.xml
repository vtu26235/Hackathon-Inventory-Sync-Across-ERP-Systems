    <munit:test name="exp-main-not-implemented" description="APIKIT:NOT_IMPLEMENTED is handled by the error handler of Retail-Inventory-Sync-API-main" expectedErrorType="APIKIT:NOT_IMPLEMENTED">
        <munit:behavior>
            <munit-tools:mock-when processor="apikit:router">
                <munit-tools:then-return>
                    <munit-tools:error typeId="APIKIT:NOT_IMPLEMENTED" />

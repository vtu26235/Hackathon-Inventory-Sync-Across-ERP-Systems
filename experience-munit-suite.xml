            <munit-tools:assert-that expression="#[vars.eventOutcome.isConflict]" is="#[MunitTools::equalTo(false)]" />
        </munit:validation>
    </munit:test>

    <munit:test name="dlq-inspector-logs-message" description="DLQ inspector flow processes a dead letter">
        <munit:behavior>
            <set-payload value="#[{eventId: 'E1', failureReason: 'db down'}]" />
        </munit:behavior>
        <munit:execution>

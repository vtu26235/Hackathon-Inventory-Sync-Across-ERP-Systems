            <munit-tools:mock-when processor="vm:publish">
                <munit-tools:then-return>
                    <munit-tools:error typeId="VM:CONNECTIVITY" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="test-raise-unexpected" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(500)]" />
            <munit-tools:assert-that expression="#[payload.errorCode]" is="#[MunitTools::equalTo('INTERNAL_SERVER_ERROR')]" />
        </munit:validation>
    </munit:test>

    <munit:test name="metrics-batch-counts" description="Batch stale and conflict counts">
        <munit:behavior>
            <set-variable variableName="correlationId" value="TEST-CORR-1" />
            <set-payload value="#[{batchId: 'B-1', results: [{status: 'ACCEPTED'}, {status: 'STALE'}, {status: 'IGNORE_STALE'}, {status: 'CONFLICT'}, {status: 'REJECTED'}, {status: 'DUPLICATE'}]}]" />
        </munit:behavior>
        <munit:execution>
            <flow-ref name="log-batch-metrics-subflow" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.batchMetrics.processed]" is="#[MunitTools::equalTo(6)]" />
            <munit-tools:assert-that expression="#[vars.batchMetrics.accepted]" is="#[MunitTools::equalTo(1)]" />
            <munit-tools:assert-that expression="#[vars.batchMetrics.stale]" is="#[MunitTools::equalTo(2)]" />
            <munit-tools:assert-that expression="#[vars.batchMetrics.versionConflict]" is="#[MunitTools::equalTo(1)]" />
            <munit-tools:assert-that expression="#[vars.batchMetrics.rejected]" is="#[MunitTools::equalTo(1)]" />
            <munit-tools:assert-that expression="#[vars.batchMetrics.duplicate]" is="#[MunitTools::equalTo(1)]" />
        </munit:validation>
    </munit:test>

    <munit:test name="metrics-event-stale-is-flagged" description="Stale outcome is flagged for alerting">
        <munit:behavior>
            <set-variable variableName="inventoryEvent" value="#[{event: {eventId: 'INV-EVT-1', sku: 'SKU-A', locationCode: 'WH-1'}}]" />
            <set-payload value="#[{status: 'IGNORE_STALE'}]" />
        </munit:behavior>
        <munit:execution>
            <flow-ref name="log-event-outcome-subflow" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.eventOutcome.isStale]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that expression="#[vars.eventOutcome.isConflict]" is="#[MunitTools::equalTo(false)]" />
        </munit:validation>
    </munit:test>

    <munit:test name="metrics-event-conflict-is-flagged" description="Conflict outcome is flagged for alerting">
        <munit:behavior>
            <set-payload value="#[{status: 'VERSION_CONFLICT'}]" />

                <munit-tools:then-return>
                    <munit-tools:error typeId="HTTP:CONNECTIVITY" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="vm:publish" />
            <set-payload value="#[{sourceSystem: 'ERP-TEST', batchId: 'B-1', events: [{eventId: 'E1', eventVersion: 1, eventTimestamp: '2026-09-11T12:40:15+05:30', sku: 'SKU-A', locationCode: 'WH-1', movementType: 'SALE', quantityOnHand: 10, reservedQuantity: 1, unitOfMeasure: 'EA'}]}]" />
        </munit:behavior>
        <munit:execution>
            <flow-ref name="post:\inventory\events:application\json:Retail-Inventory-Sync-API-config" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo(503)]" />
            <munit-tools:assert-that expression="#[payload.errorCode]" is="#[MunitTools::equalTo('SERVICE_UNAVAILABLE')]" />
            <munit-tools:assert-that expression="#[payload.valid]" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:verify-call processor="vm:publish" times="1" />
        </munit:validation>
    </munit:test>


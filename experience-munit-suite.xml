        <munit:validation>
            <munit-tools:assert-that expression="#[vars.eventOutcome.isConflict]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that expression="#[vars.eventOutcome.isStale]" is="#[MunitTools::equalTo(false)]" />
        </munit:validation>
    </munit:test>

    <munit:test name="metrics-event-accepted-no-alert" description="Accepted outcome is not an alert">
